<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission for Live Floating Progress Panel while Settings is automated -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    
    <!--
        Broad package visibility is required by the core app-management feature:
        the whitelist and force-stop candidate screens enumerate installed apps locally,
        then exclude system apps, this app, and critical system roles before any action.
        Keep this permission narrowly scoped to that user-facing functionality.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatusBarManager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StatusBarManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Screen Widget Provider (Objective 4) -->
        <receiver
            android:name=".widget.HushButtonIconWidgetProvider"
            android:exported="true"
            android:label="@string/widget_hush_button_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/syshush_hush_button_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StopAppsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stop_apps_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/syshush_stop_apps_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StatusBarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.statusbarmanager.app.widget.ACTION_WIDGET_TOGGLE" />
                <action android:name="com.statusbarmanager.app.widget.ACTION_WIDGET_FORCE_STOP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/status_bar_widget_info" />
        </receiver>

        <!-- Dedicated Android Accessibility Service for Automating Status Bar Settings & Force Stop -->
        <service
            android:name=".service.StatusBarAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:description="@string/accessibility_service_description">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/status_bar_accessibility_service_config" />
        </service>

    </application>

</manifest>
